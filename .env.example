# Copy to .env and fill in. NEVER commit .env.
POSTGRES_PASSWORD=generate-a-strong-one
API_SECRET=generate-a-long-random-string
DATABASE_URL=postgresql+psycopg2://aibos:${POSTGRES_PASSWORD}@localhost:5432/aibos
REDIS_URL=redis://localhost:6379/0
ENV=development
# Local dev without docker: DATABASE_URL=sqlite:///./aibos.db
